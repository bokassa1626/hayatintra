# ============================================================================
# Configuration — à copier en .env et à adapter (ne jamais committer le .env réel)
# ============================================================================

# Connexion MySQL — installer MySQL localement (gratuit) :
# Windows/Mac : MySQL Community Server / XAMPP / WAMP
# Linux : sudo apt install mysql-server
#
# Format : mysql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="mysql://root:motdepasse@localhost:3306/hayatcom_intranet"

# Port du serveur backend
PORT=4000

# Secrets JWT (à générer aléatoirement en production, ex: openssl rand -hex 32)
JWT_ACCESS_SECRET="change-moi-secret-access-dev-uniquement"
JWT_REFRESH_SECRET="change-moi-secret-refresh-dev-uniquement"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Dossier de stockage des fichiers uploadés (simulation Samba)
UPLOAD_DIR="./uploads"

# URL du frontend (pour CORS)
FRONTEND_URL="http://localhost:5173"
